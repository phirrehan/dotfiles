#!/bin/sh

# this is a wrapper script for playerctl that only
# controls a specific media player stored in $default_player.

# variables 
media_file="$HOME/.local/state/default_player.txt"
[ -f "$media_file" ] || : >"$media_file"
top_player=$(playerctl -l 2>/dev/null | head -n1)
chosen_player=$(cat "$media_file")
[ -z "$chosen_player" ] && chosen_player="$top_player"

# functions
help() {
  cat <<EOF
Usage: $0 <arg>

Arguments:
  play-pause:    toggle the media playing.
  volume:        <percentage>[+|-]
  next:          play next media.
  previous:      play previous media.
  loop:          toggle loop state.
  -h | --help | help
                print this message
  EOF
}
toggleplay() {
  playerctl --player "$chosen_player" play-pause
}
volume() {
  number=$(printf '%s' "$1" | grep -Eo "[0-9]+")
  number=$(echo "scale=2; $number / 100" | bc)
  operator=$(printf '%s' "$1" | grep -Eo "(\+)|(-)")
  [ -z "$number" ] && exit 1
  playerctl --player "$chosen_player" volume "$number$operator"
}
next() {
  playerctl --player "$chosen_player" next
}
prev() {
  playerctl --player "$chosen_player" previous
}
toggleloop() {
  [ -z "$chosen_player" ] && echo "no media playing" && exit 2
  if playerctl --player "$chosen_player" loop | grep -qi none; then
      playerctl --player "$chosen_player" loop track
  else
      playerctl --player "$chosen_player" loop none
  fi
}
choose() {
  chosen="$(playerctl -l | fuzzel --dmenu "Choose a media player")"
  echo "$chosen"  >"$media_file" 2>/dev/null
}

# start
case "$1" in
"help" | "--help") help ;;
"play-pause") toggleplay ;;
"volume") volume "$2" ;;
"next") next ;;
"previous") prev ;;
"loop") toggleloop ;;
"choose") choose ;;
*)
  echo "invalid argument. use -h or --help for help"
  exit 3
  ;;
esac
